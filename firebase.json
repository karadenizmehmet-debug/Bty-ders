{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "README.md"],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "surum.js",  "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "motor/lib/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
